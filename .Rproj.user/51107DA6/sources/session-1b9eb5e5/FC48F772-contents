project:
  type: website
  output-dir: _site

website:
  title: "Glaucoma Spatial Transcriptomics"
  description: "Slide-tag snRNA-seq → Seurat v5 → scVI → CellRank 2 — A preregistered pipeline for glaucoma microenvironment pathology"
  favicon: assets/figures/favicon.svg

  navbar:
    background: "#0a0f1e"
    foreground: "#e8e4d9"
    logo: assets/figures/logo.svg
    logo-alt: "Glaucoma ST Pipeline"
    left:
      - text: "Overview"
        href: index.qmd
      - text: "Methods"
        href: methods.qmd
      - text: "Validation"
        href: validation.qmd
      - text: "Targets"
        href: targets.qmd
      - text: "References"
        href: references.qmd
    right:
      - icon: github
        href: https://github.com/your-lab/glaucoma-spatial-pipeline
        aria-label: GitHub

  sidebar: false

  page-footer:
    background: "#0a0f1e"
    left: "© 2025 — Released under MIT License"
    center: "Built with [Quarto](https://quarto.org)"
    right: "Pipeline v1.0.0"

  open-graph:
    title: "Glaucoma Spatial Transcriptomics Pipeline"
    description: "Preregistered Slide-tag snRNA-seq → CellRank 2 pipeline"
    image: assets/figures/og-card.png

format:
  html:
    theme: [darkly, assets/css/pipeline-theme.scss]
    css: assets/css/custom.css
    toc: true
    toc-depth: 3
    toc-title: "On this page"
    code-fold: true
    code-summary: "Show code"
    code-copy: true
    code-overflow: wrap
    highlight-style: monokai
    fig-align: center
    fig-cap-location: bottom
    smooth-scroll: true
    anchor-sections: true
    citations-hover: true
    footnotes-hover: true
    html-math-method: mathjax
    bibliography: references.bib
    csl: https://www.zotero.org/styles/nature

execute:
  echo: true
  warning: false
  message: false
  cache: true
