// =============================================================================
// nextflow.config
// Resource profiles for Mac (local), HPC SLURM, and test mode.
// =============================================================================

// ── Container image registry ──────────────────────────────────────────────────
def REGISTRY = "ghcr.io/tjmb03"
def VERSION  = "1.0.0"

// ── Global defaults ───────────────────────────────────────────────────────────
manifest {
    name            = "microenvi-spatial-pipeline"
    description     = "Slide-tag snRNA-seq spatial transcriptomics pipeline"
    version         = "1.0.0"
    author          = "tjmb03"
    nextflowVersion = ">=23.04.0"
    mainScript      = "nextflow/main.nf"
}

params {
    // Required — no defaults
    sample_sheet     = null
    genome           = null

    // Optional
    reference        = null
    outdir           = "results"
    python3          = "python3"  // overridden by dev profile
    threads_align    = 16
    threads_velocity = 8
    n_top_genes      = 2000
    skip_opentargets = false
    dev_mode         = false
    publish_dir_mode = "copy"

    // Test mode — uses Tran 2019 prototype data
    test_mode        = false
    test_data_dir    = "prototype/data/tran2019"
}

// ── Process defaults ──────────────────────────────────────────────────────────
process {
    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 140, 143, 247] ?
                      'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'

    // Container assignments per process name
    withName: 'VALIDATE_PREREG' {
        container = "${REGISTRY}/microenvi-scvi:${VERSION}"
        cpus      = 1
        memory    = '2 GB'
        time      = '5m'
    }
    withName: 'STARSOLO' {
        container = "${REGISTRY}/microenvi-star:${VERSION}"
        cpus      = 16
        memory    = '64 GB'
        time      = '4h'
    }
    withName: 'SEURAT_PROCESSING' {
        container = "${REGISTRY}/microenvi-seurat:${VERSION}"
        cpus      = 8
        memory    = '32 GB'
        time      = '2h'
    }
    withName: 'CONVERT_H5AD' {
        container = "${REGISTRY}/microenvi-scvi:${VERSION}"
        cpus      = 2
        memory    = '8 GB'
        time      = '30m'
    }
    withName: 'SCVI_INTEGRATION' {
        container = "${REGISTRY}/microenvi-scvi:${VERSION}"
        cpus      = 8
        memory    = '64 GB'
        time      = '6h'
    }
    withName: 'SCVELO' {
        container = "${REGISTRY}/microenvi-scvelo:${VERSION}"
        cpus      = 8
        memory    = '48 GB'
        time      = '4h'
    }
    withName: 'CELLRANK' {
        container = "${REGISTRY}/microenvi-cellrank:${VERSION}"
        cpus      = 8
        memory    = '64 GB'
        time      = '4h'
    }
    withName: 'SPATIAL_STATISTICS' {
        container = "${REGISTRY}/microenvi-cellrank:${VERSION}"
        cpus      = 4
        memory    = '32 GB'
        time      = '2h'
    }
    withName: 'LINEAGE_DRIVERS' {
        container = "${REGISTRY}/microenvi-cellrank:${VERSION}"
        cpus      = 4
        memory    = '32 GB'
        time      = '3h'
    }
    withName: 'VALIDATE_PIPELINE' {
        container = "${REGISTRY}/microenvi-scvi:${VERSION}"
        cpus      = 1
        memory    = '4 GB'
        time      = '30m'
    }
}

// ── Profiles ──────────────────────────────────────────────────────────────────
profiles {

    // ── Local Mac (Docker Desktop) ────────────────────────────────────────────
    docker {
        docker.enabled      = true
        docker.runOptions   = '-u $(id -u):$(id -g)'
        singularity.enabled = false

        process {
            // Reduced resources for local development
            withName: 'STARSOLO' {
                cpus   = 4
                memory = '16 GB'
            }
            withName: 'SCVI_INTEGRATION' {
                cpus   = 4
                memory = '16 GB'
            }
            withName: 'SCVELO|CELLRANK' {
                cpus   = 4
                memory = '16 GB'
            }
        }
    }

    // ── HPC SLURM + Singularity ───────────────────────────────────────────────
    slurm {
        process.executor    = 'slurm'
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled      = false

        process {
            withName: 'STARSOLO' {
                queue          = 'cpu'
                clusterOptions = '--account=your_account'
            }
            withName: 'SCVI_INTEGRATION' {
                queue          = 'gpu'
                clusterOptions = '--account=your_account --gres=gpu:1'
                containerOptions = '--nv'   // Singularity NVIDIA GPU passthrough
            }
        }

        executor {
            queueSize       = 50
            pollInterval    = '1 min'
            submitRateLimit = '10/1min'
        }
    }

    // ── AWS Batch ─────────────────────────────────────────────────────────────
    awsbatch {
        process.executor    = 'awsbatch'
        process.queue       = 'your-aws-batch-queue'
        aws.region          = 'us-east-1'
        docker.enabled      = true
    }

    // ── Test profile (Tran 2019 prototype data) ───────────────────────────────
    test {
        docker.enabled = true
        params {
            test_mode        = true
            sample_sheet     = "prototype/test_sample_sheet.csv"
            genome           = null   // skips STARsolo — uses pre-built h5ad
            outdir           = "prototype/output/nextflow_test"
            skip_opentargets = true
            dev_mode         = true   // minimal epochs
        }

        process {
            // Minimal resources for CI testing — override per-process defaults
            cpus   = 2
            memory = '8 GB'
            time   = '30m'

            withName: 'VALIDATE_PREREG'    { cpus = 1; memory = '2 GB'; time = '5m' }
            withName: 'SCVI_INTEGRATION'   { cpus = 2; memory = '8 GB'; time = '30m' }
            withName: 'SCVELO'             { cpus = 2; memory = '8 GB'; time = '30m' }
            withName: 'CELLRANK'           { cpus = 2; memory = '8 GB'; time = '30m' }
            withName: 'SPATIAL_STATISTICS'  { cpus = 2; memory = '8 GB'; time = '30m' }
            withName: 'LINEAGE_DRIVERS'    { cpus = 2; memory = '8 GB'; time = '30m' }
            withName: 'VALIDATE_PIPELINE'  { cpus = 1; memory = '4 GB'; time = '30m' }
        }
    }

    // ── Development (fast iteration, no Docker) ───────────────────────────────
    dev {
        docker.enabled   = false
        process.executor = 'local'

        params {
            dev_mode         = true
            skip_opentargets = true
            outdir           = "dev_output"
            python3          = "${System.getenv('HOME')}/anaconda3/envs/glaucoma-scvi/bin/python3"
        }
    }
}

// ── Execution reports ─────────────────────────────────────────────────────────
report {
    enabled   = true
    file      = "${params.outdir}/pipeline_report.html"
    overwrite = true
}

timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_timeline.html"
    overwrite = true
}

dag {
    enabled   = true
    file      = "${params.outdir}/pipeline_dag.svg"
    overwrite = true
}

trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_trace.txt"
    overwrite = true
    fields    = 'task_id,hash,name,status,exit,realtime,%cpu,%mem,rss,vmem,rchar,wchar'
}

// ── Singularity cache ─────────────────────────────────────────────────────────
singularity {
    cacheDir = "${HOME}/.singularity/cache"
}
